{
  "mcpServers": {
    "amanuensis-memory": {
      "type": "stdio",
      "command": "mise",
      "args": [
        "-C",
        "${CLAUDE_PROJECT_DIR:-.}",
        "exec",
        "--",
        "node",
        "${CLAUDE_PROJECT_DIR:-.}/mcp-server/dist/index.js",
        "--workspace",
        "${CLAUDE_PROJECT_DIR:-.}"
      ],
      "env": {
        "AMANUENSIS_AUTOPROGRESS": "1"
      }
    }
  }
}
