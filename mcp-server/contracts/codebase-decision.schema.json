{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amanuensis.dev/contracts/codebase-decision/1.0.0",
  "title": "Amanuensis CodebaseDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision", "revision", "events", "authority"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "decision": {
      "type": "object",
      "required": ["decision_id", "title", "current_revision_id"],
      "properties": {
        "decision_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "current_revision_id": { "type": ["string", "null"] }
      }
    },
    "revision": {
      "type": "object",
      "required": [
        "revision_id", "decision_id", "revision_number", "status",
        "desire_sources", "accepted_option", "alternatives", "constraints",
        "consequences", "falsifiers", "premises", "code_changes", "rationale",
        "authored_by_kind", "authored_by", "payload_hash"
      ],
      "properties": {
        "revision_id": { "type": "string", "minLength": 1 },
        "decision_id": { "type": "string", "minLength": 1 },
        "revision_number": { "type": "integer", "minimum": 1 },
        "predecessor_revision_id": { "type": ["string", "null"] },
        "design_session_id": { "type": ["string", "null"] },
        "status": { "enum": ["draft", "accepted", "rejected", "superseded", "invalidated"] },
        "desire_sources": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "accepted_option": { "type": "object" },
        "alternatives": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "constraints": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "consequences": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "falsifiers": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "premises": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "code_changes": { "type": "array", "items": { "type": "object" } },
        "rationale": { "type": "string", "minLength": 1 },
        "authored_by_kind": { "enum": ["model", "human", "owning-system"] },
        "authored_by": { "type": "string", "minLength": 1 },
        "payload_hash": { "type": "string", "minLength": 1 }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["event_type", "actor_kind", "actor_id", "reason", "detail"],
        "properties": {
          "event_type": { "enum": ["drafted", "accepted", "rejected", "superseded", "invalidated", "impact-detected"] },
          "actor_kind": { "enum": ["model", "human", "owning-system", "amanuensis"] },
          "actor_id": { "type": "string", "minLength": 1 },
          "authority_scope": { "type": ["string", "null"] },
          "reason": { "type": "string", "minLength": 1 },
          "evidence_id": { "type": ["integer", "null"] },
          "impact_run_id": { "type": ["string", "null"] },
          "detail_json": { "type": "string" },
          "created_at": { "type": "string" },
          "detail": { "type": "object" }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "transfer", "acceptance_remains_with_source"],
      "properties": {
        "source": { "const": "amanuensis" },
        "transfer": { "const": "projection-only" },
        "acceptance_remains_with_source": { "const": true }
      }
    }
  }
}
