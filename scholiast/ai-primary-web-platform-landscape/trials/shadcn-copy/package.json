{
  "name": "amanuensis-shadcn-copy-owned-trial",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:document && npm run build:client",
    "build:document": "tailwindcss -i src/index.css -o dist/report.css --minify && tsx scripts/build-document.tsx",
    "build:client": "vite build --outDir dist-client --emptyOutDir",
    "css": "tailwindcss -i src/index.css -o dist/report.css --minify",
    "registry:capture": "node scripts/capture-registry.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@tailwindcss/cli": "4.3.3",
    "shadcn": "4.19.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
